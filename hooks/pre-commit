#!/bin/sh
# Runs the quality checks on what is about to be committed and rejects the
# commit when one of them fails. Installed per clone with "make hooks".
#
# The checks run on a copy of the staged files, not on the working tree: what
# is checked is what gets committed, and neither the working tree nor the index
# is changed. Nothing is formatted, fixed or staged for you.
#
# The mutation tests are left to hooks/pre-push, which runs them for main.
#
#	git commit --no-verify       skip the hook altogether
set -eu

top=$(git rev-parse --show-toplevel)

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
if [ -z "$staged" ]; then
	echo "pre-commit: nothing staged, nothing to check."
	exit 0
fi

# Only code and the checks themselves need checking; a commit of prose does not.
relevant=$(printf '%s\n' "$staged" | grep -E '(\.go|\.sh)$|^(go\.mod|go\.sum|Makefile|staticcheck\.conf|\.gremlins\.yaml|coverage-exclusions\.txt|mutation-equivalents\.txt|mutation-uncoverable\.txt)$|^(scripts|hooks)/' || true)
if [ -z "$relevant" ]; then
	echo "pre-commit: no Go code or check configuration staged, nothing to check."
	exit 0
fi

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/ouro-pre-commit.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 130' INT TERM HUP

git checkout-index --all --prefix="$snapshot/tree/"

# Git runs hooks with GIT_DIR, GIT_INDEX_FILE and friends set. Tests that run
# git themselves would act on this repository instead of their own.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

# The pinned tools are built once, in the checkout, not once per commit.
OURO_TOOLS_DIR=${OURO_TOOLS_DIR:-$top/.tools}
export OURO_TOOLS_DIR

cd "$snapshot/tree"

step() {
	name=$1
	target=$2
	echo "pre-commit: $name ..."
	if ! make --no-print-directory "$target"; then
		cat >&2 <<EOF

pre-commit: $name failed, the commit was rejected. Nothing was changed.
  The staged files were checked, not the working tree: fix, "git add", commit again.
  Paths above are relative to the repository; absolute ones point into a
  temporary copy of the staged files.
  Run this check alone: make $target      all of them: make check
  Commit without the checks: git commit --no-verify
EOF
		exit 1
	fi
}

start=$(date +%s)
step "formatting (gofmt)" fmt-check
step "static analysis (staticcheck)" lint
step "go vet and tests with the race detector" test
step "statement coverage (100% of the production code)" cover-check

echo "pre-commit: ok, $(($(date +%s) - start))s."
